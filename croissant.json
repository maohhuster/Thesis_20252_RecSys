        },
        {
          "@type": "cr:Field",
          "name": "movieId",
          "dataType": "sc:Integer",
          "description": "Movie identifier (matches movie_profiles.movieId)",
          "source": {
            "fileObject": {
              "@id": "test_split"
            },
            "extract": {
              "column": "movieId"
            }
          },
          "@id": "interactions_test/movieId"
        },
        {
          "@type": "cr:Field",
          "name": "timestamp",
          "dataType": "sc:Integer",
          "description": "Unix timestamp of the rating (used for temporal split)",
          "source": {
