  "@type": "sc:Dataset",
  "name": "LLM-MovieLens",
  "description": "LLM-synthesized movie profiles and pre-computed embeddings for 10,381 genome-covered movies from MovieLens 20M. Each profile includes an 80-120 word semantic description, a 10-axis mood vector, and 3 key themes, generated by Claude Haiku 4.5 from genome tags and TMDb metadata. Designed as a benchmark for evaluating LLM-generated features in collaborative filtering recommendation.",
  "url": "https://huggingface.co/datasets/anonyauthor4review/llm-movielens",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "version": "1.1.0",
  "datePublished": "2026-05-07",
  "creator": [
    {
      "@type": "Organization",
      "name": "Anonymous Authors",
      "url": "https://github.com/anonyauthor4review-png"
    }
  ],
  "keywords": [
    "recommendation systems",
    "collaborative filtering",
    "large language models",
    "movie embeddings",
    "MovieLens",
    "benchmark",
    "CIKM 2026"
  ],
  "isBasedOn": {
    "@type": "sc:Dataset",
    "name": "MovieLens 20M",
    "url": "https://grouplens.org/datasets/movielens/20m/",
    "creator": {
      "@type": "Organization",
      "name": "GroupLens Research"
    }
  },
