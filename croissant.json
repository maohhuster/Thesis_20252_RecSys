  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "movie_profiles",
      "name": "Movie Profiles",
      "description": "LLM-generated profiles for 10,381 genome-covered movies. Scalar fields below are extracted via Croissant; nested fields not declared here but present in the JSON: mood_vector (dict with 10 axes: dark_light, serious_playful, slow_fast, cerebral_visceral, realistic_fantastical, intimate_epic, conventional_experimental, emotional_detached, nostalgic_contemporary, predictable_subversive \u2014 values in [-1, 1]); key_themes (list of 3\u20135 string labels). Reviewers needing structured access to nested fields should load the JSON file directly (it is dict-keyed by movieId).",
      "field": [
        {
          "@type": "cr:Field",
          "name": "movieId",
          "description": "MovieLens 20M movie identifier",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "profiles"
            },
            "extract": {
              "jsonPath": "$.*.movieId"
            }
          },
          "@id": "movie_profiles/movieId"
        },
        {
          "@type": "cr:Field",
          "name": "title",
          "description": "Movie title with release year",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "profiles"
            },
            "extract": {
              "jsonPath": "$.*.title"
            }
          },
          "@id": "movie_profiles/title"
        },
        {
          "@type": "cr:Field",
          "name": "profile",
          "description": "80-120 word embedding-optimised semantic profile (key 'profile' in source JSON)",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "profiles"
            },
            "extract": {
              "jsonPath": "$.*.profile"
            }
          },
          "@id": "movie_profiles/profile"
        },
        {
          "@type": "cr:Field",
          "name": "word_count",
          "description": "Profile word count (constraint: 80\u2013120)",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "profiles"
            },
            "extract": {
              "jsonPath": "$.*.word_count"
            }
          },
          "@id": "movie_profiles/word_count"
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "interactions_train",
      "name": "Benchmark Interactions (train)",
      "description": "Temporal train split of MovieLens 20M for genome-covered movies (implicit-feedback; no explicit rating column).",
      "field": [
        {
          "@type": "cr:Field",
          "name": "userId",
          "dataType": "sc:Integer",
          "description": "User identifier (original ML-20M userId)",
          "source": {
            "fileObject": {
              "@id": "train_split"
            },
            "extract": {
              "column": "userId"
            }
          },
          "@id": "interactions_train/userId"
        },
        {
          "@type": "cr:Field",
          "name": "movieId",
          "dataType": "sc:Integer",
          "description": "Movie identifier (matches movie_profiles.movieId)",
          "source": {
            "fileObject": {
              "@id": "train_split"
            },
            "extract": {
              "column": "movieId"
            }
          },
          "@id": "interactions_train/movieId"
        },
        {
          "@type": "cr:Field",
          "name": "timestamp",
          "dataType": "sc:Integer",
          "description": "Unix timestamp of the rating (used for temporal split)",
          "source": {
            "fileObject": {
              "@id": "train_split"
            },
            "extract": {
              "column": "timestamp"
            }
          },
          "@id": "interactions_train/timestamp"
        }
      ]
    },
